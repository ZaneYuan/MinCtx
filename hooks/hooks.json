{
  "description": "MinCtx: protocol injection, oversized-read guard, turn-end session hand-off",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/minctx.js\" session-start", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/minctx.js\" prompt-submit", "timeout": 15 }] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Bash|PowerShell", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/minctx.js\" pre-tool", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/minctx.js\" stop", "timeout": 15 }] }
    ]
  }
}
